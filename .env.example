# Copiati in .env si completati. Nu adaugati .env in git.
HCA_DATA_DIR=./data
# Google Drive: service_account (recomandat) sau oauth
HCA_DRIVE_AUTH=service_account
HCA_GOOGLE_CREDENTIALS=./secrets/service-account.json
# HCA_GOOGLE_TOKEN=./secrets/google_token.json   # doar pentru oauth
# Claude API (fara cheie, aplicatia ruleaza in mod euristic, cu fiabilitate redusa)
ANTHROPIC_API_KEY=
HCA_LLM_MODEL=claude-sonnet-5-5
# Securitate
HCA_ENCRYPTION_KEY=          # cheie Fernet; generare: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
HCA_USERS_FILE=./config/users.json
HCA_AUTH_DISABLED=0          # 1 doar pentru dezvoltare locala
HCA_ALLOW_SELF_APPROVAL=0    # 1 doar daca exista un singur administrator
HCA_RETENTION_DAYS=90
HCA_MAX_FILE_MB=40
# OCR si cautare
HCA_OCR_LANGS=ron+eng
HCA_EMBEDDINGS=auto          # auto | tfidf | st
